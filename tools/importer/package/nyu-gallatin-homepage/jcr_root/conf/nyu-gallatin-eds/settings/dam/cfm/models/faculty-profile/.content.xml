<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Template"
    ranking="{Long}100"
    allowedPaths="[/content/dam/nyu-gallatin-eds(/.*)?]">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Faculty Profile"
        jcr:description="NYU Gallatin faculty profile: identity, contact, biography, education, research interests, publications, and honors."
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        cq:scaffolding="/conf/nyu-gallatin-eds/settings/dam/cfm/models/faculty-profile/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        status="enabled">
        <model jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            cq:targetPath="/content/dam/nyu-gallatin-eds"
            maxGeneratedOrder="20">
            <cq:dialog jcr:primaryType="nt:unstructured" sling:resourceType="cq/gui/components/authoring/dialog">
                <content jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items jcr:primaryType="nt:unstructured" maxGeneratedOrder="20">
        <name jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Name" name="name" valueType="string" metaType="text-single"
          listOrder="1" maxlength="255" showEmptyInReadOnly="true" renderReadOnly="false" required="on"/>
        <role jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Title / Role" name="role" valueType="string" metaType="text-single"
          listOrder="2" maxlength="255" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <department jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Department / School" name="department" valueType="string" metaType="text-single"
          listOrder="3" maxlength="255" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <photo jcr:primaryType="nt:unstructured"
          sling:resourceType="dam/cfm/models/editor/components/contentreference"
          fieldLabel="Photo" name="photo" valueType="string/reference" metaType="reference"
          listOrder="4" filter="hierarchy" nameSuffix="contentReference" rootPath="/content/dam" showThumbnail="true" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <email jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Email" name="email" valueType="string" metaType="text-single"
          listOrder="5" maxlength="255" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <pronouns jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Pronouns" name="pronouns" valueType="string" metaType="text-single"
          listOrder="6" maxlength="255" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <profileUrl jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Profile URL" name="profileUrl" valueType="string" metaType="text-single"
          listOrder="7" maxlength="255" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <shortBio jcr:primaryType="nt:unstructured"
          sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
          fieldLabel="Short Bio" name="shortBio" valueType="string/multiline" metaType="text-multi"
          listOrder="8" cfm-element="Short Bio" default-mime-type="text/plain" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <bio jcr:primaryType="nt:unstructured"
          sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
          fieldLabel="Biography" name="bio" valueType="string" metaType="text-rich"
          listOrder="9" cfm-element="Biography" default-mime-type="text/html" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <education jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Education" name="education" valueType="string[]" metaType="text-single"
          listOrder="10" multiple="{Boolean}true" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <researchInterests jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Research Interests" name="researchInterests" valueType="string[]" metaType="text-single"
          listOrder="11" multiple="{Boolean}true" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <publications jcr:primaryType="nt:unstructured"
          sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
          fieldLabel="Publications" name="publications" valueType="string" metaType="text-rich"
          listOrder="12" cfm-element="Publications" default-mime-type="text/html" showEmptyInReadOnly="true" renderReadOnly="false"/>
        <awards jcr:primaryType="nt:unstructured"
          sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
          fieldLabel="Awards &amp; Honors" name="awards" valueType="string" metaType="text-rich"
          listOrder="13" cfm-element="Awards &amp; Honors" default-mime-type="text/html" showEmptyInReadOnly="true" renderReadOnly="false"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
