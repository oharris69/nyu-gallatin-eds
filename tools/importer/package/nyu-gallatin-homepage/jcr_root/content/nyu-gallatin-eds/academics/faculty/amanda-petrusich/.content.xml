      <section_2 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,style,sec-full-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Work" titleType="h2"/>
        <title_1 sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Amanda&#x27;s Publications" titleType="h2"/>
        <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;h3&gt;Books&lt;/h3&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://www.simonandschuster.com/books/Do-Not-Sell-At-Any-Price/Amanda-Petrusich/9781451667066&quot;&gt;Do Not Sell at Any Price: The Wild, Obsessive Hunt for the World&#x27;s Rarest 78rpm Records&lt;/a&gt; — published by Scribner in 2014.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://www.faber.co.uk/9780571234202-it-still-moves.html&quot;&gt;It Still Moves: Lost Songs, Lost Highways, and the Search for the Next American Music&lt;/a&gt; — published by Faber and Faber in 2008.&lt;/p&gt;&lt;h3&gt;Articles&lt;/h3&gt;&lt;p&gt;For the November 2016 issue of &lt;em&gt;Esquire,&lt;/em&gt; Petrusich wrote &lt;a href&#x3D;&quot;http://www.esquire.com/entertainment/a50341/michael-fassbender-interview/&quot;&gt;&quot;Michael Fassbender&#x27;s Secret: Stop Overthinking.&quot;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Petrusich wrote several articles for &lt;a href&#x3D;&quot;http://www.newyorker.com/search?q&#x3D;Petrusich&quot;&gt;The New Yorker,&lt;/a&gt; and about D&#x27;Angelo for the 2016 &lt;em&gt;New York Times Magazine&lt;/em&gt; feature &lt;a href&#x3D;&quot;http://www.nytimes.com/interactive/2016/03/10/magazine/25-songs-that-tell-us-where-music-is-going.html&quot;&gt;&quot;25 Songs That Tell Us Where Music is Going.&quot;&lt;/a&gt;&lt;/p&gt;"/>
      </section_2>
      <section_3 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" style="light" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,style,sec-full-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Commendations" titleType="h2"/>
        <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;h3&gt;Awards and Honors&lt;/h3&gt;&lt;p&gt;2019 Grammy Nomination as an album notes writer for Dylan&#x27;s &quot;Trouble No More,&quot; Volume 13 in the Bootleg Series.&lt;/p&gt;&lt;p&gt;2016 fellowship in nonfiction from the John Simon Guggenheim Memorial Foundation.&lt;/p&gt;&lt;p&gt;Named one of the 100 Most Influential People in Brooklyn Culture by &lt;em&gt;Brooklyn Magazine.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;Series editor of Bloomsbury&#x27;s 33 1/3 Series.&lt;/p&gt;&lt;h3&gt;Residencies&lt;/h3&gt;&lt;p&gt;2019 Artist in Residence at the Headlands Center for Arts, San Francisco, CA.&lt;/p&gt;"/>
      </section_3>
