        <block_2 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="carousel" model="carousel" modelFields="[autoplay,autoplayInterval,imageZoom]" name="Carousel">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/experiential-learning/2025-wetlab-mushroom-2000x1125.jpg" text="&lt;p&gt;&lt;h3&gt;Art + Environment&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;From its home on Governors Island, the Gallatin WetLab convenes students, faculty, and the public to explore the intersections of art and science—and to seek interdisciplinary solutions to the climate crisis.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Location:&lt;/strong&gt; 20 Evans Rd., Ste. A, New York, NY 10004&lt;br&gt; &lt;strong&gt;Email:&lt;/strong&gt; &lt;a href&#x3D;&quot;mailto:gallatin.wetlab@nyu.edu&quot;&gt;gallatin.wetlab@nyu.edu&lt;/a&gt;&lt;br&gt; &lt;strong&gt;Hours:&lt;/strong&gt; June–August, Fri.–Sun., 10 a.m.–4 p.m.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://wp.nyu.edu/gallatinwetlab/&quot;&gt;Gallatin WetLab&lt;/a&gt;&lt;/p&gt;"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/events/2025/2025-04-gaf-253-2000x1125.jpg" text="&lt;p&gt;&lt;h3&gt;A Festival of Creativity&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;Each year, the Gallatin Arts Festival celebrates the unique artistry and interdisciplinary scholarship of Gallatin students, who come together to create unique works and produce the festival itself.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://wp.nyu.edu/gallatingalleries/gallatin-arts-festival/&quot;&gt;Gallatin Arts Festival&lt;/a&gt;&lt;/p&gt;"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/experiential-learning/2025-literacy-review-cover-2000x1125.jpg" text="&lt;p&gt;&lt;h3&gt;Literacy First&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;Edited and produced by Gallatin students, &lt;em&gt;The Literacy Review&lt;/em&gt; is an annual publication of writing from adult literacy programs across New York City. Students and faculty collaborate on every aspect of this incredible work.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/academics/writing-arts.html&quot;&gt;Writing and The Arts&lt;/a&gt;&lt;/p&gt;"></item_2>
          <item_3 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/events/2025/2025-games-fashion-show-0476-023-2000x1125.jpg" text="&lt;p&gt;&lt;h3&gt;Collaborative Couture&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;The Gallatin Fashion Show brings together student-designers from across Gallatin—and from across disciplines—to create unique collections for this annual runway show.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/academics/writing-arts.html#fashion&quot;&gt;Fashion at Gallatin&lt;/a&gt;&lt;/p&gt;"></item_3>
          <item_4 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/experiential-learning/2023-stac-2000x1125.jpg" text="&lt;p&gt;&lt;h3&gt;Ideate and Build&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;The Science, Technology, Arts + Creativity (STAC) Makerspace at Gallatin offers students the community, training, resources, and space to bring their ideas to life—and to take their education in exciting and practical new directions.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/academics/experiences/making-innovation.html&quot;&gt;Making and Innovation&lt;/a&gt;&lt;/p&gt;"></item_4>
        </block_2>
        <block_3 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="cards" name="Cards">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/students-alums/2025-10-agnese-salvatico-ba-portrait-1050x1575.jpg" text="&lt;p&gt;&quot;As an international student, I wanted that diveristy as part of my college experience. Gallatin feels like the most diverse community at NYU.&quot;&lt;/p&gt;&lt;p&gt;&lt;h3&gt;Agnese&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;&lt;h3&gt;&lt;strong&gt;BA &#x27;28&lt;/strong&gt;&lt;/h3&gt;&lt;/p&gt;"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/students-alums/2025-10-navaneeth-unnikrishnan-ba-portrait-1050x1575.jpg" text="&lt;p&gt;&quot;The community—the students, the professors, the staff—is absolutely the best thing about going to school at Gallatin.&quot;&lt;/p&gt;&lt;p&gt;&lt;h3&gt;Navaneeth&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;&lt;h3&gt;&lt;strong&gt;BA &#x27;26&lt;/strong&gt;&lt;/h3&gt;&lt;/p&gt;"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/students-alums/2025-10-ty-dierberg-ba-portrait-900x1599.jpg" text="&lt;p&gt;&quot;Meeting my classmates has been one of the most inspiring parts of my experience at Gallatin. Gallatin students do some of the most interesting activities and are at the forefront of interdisciplinary studies. Learning about their work has been so motivating for me.&quot;&lt;/p&gt;&lt;p&gt;&lt;h3&gt;Ty&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;&lt;h3&gt;&lt;strong&gt;BA &#x27;27&lt;/strong&gt;&lt;/h3&gt;&lt;/p&gt;"></item_2>
        </block_3>
        <block_4 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="cards" name="Cards">
