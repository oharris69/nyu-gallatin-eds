        <block sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="carousel" model="carousel" modelFields="[autoplay,autoplayInterval,imageZoom]" name="Carousel">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/students-alums/2026-ben-kubany-alum-portrait-homepage-hero-2000x1125.jpg" text="&lt;p&gt;&lt;strong&gt;At Gallatin,&lt;/strong&gt; I integrated concepts and frameworks across multiple disciplines.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Ben Kubany, BA &#x27;23&lt;/strong&gt; Head of Business Development and Associate Project Manager at JLP+D&lt;/p&gt;&lt;p&gt;&lt;strong&gt;After Gallatin,&lt;/strong&gt; I solve complex interdisciplinary challenges for cities across the country.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/life-after-gallatin/put-your-degree-to-work.html&quot;&gt;Put Your Degree to Work&lt;/a&gt;&lt;/p&gt;"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/students-alums/2026-solmy-lee-alum-portrait-homepage-hero-2000x1125.jpg" text="&lt;p&gt;&lt;strong&gt;At Gallatin,&lt;/strong&gt; I approached each class with an intense focus on that topic, and worked with my adviser to incorporate it all into my thesis.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Solmy Lee, MA &#x27;21&lt;/strong&gt; Programme Officer, UN Office for Partnerships&lt;/p&gt;&lt;p&gt;&lt;strong&gt;After Gallatin,&lt;/strong&gt; I&#x27;ve continued to use the approach to thinking and working that I learned here to do what I do well.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/why-gallatin/education-with-intention.html&quot;&gt;Education With Intention&lt;/a&gt;&lt;/p&gt;"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/students-alums/2026-sophie-spector-alum-portrait-homepage-hero-2000x11251.png" text="&lt;p&gt;&lt;strong&gt;At Gallatin,&lt;/strong&gt; I cultivated my ability to think about challenges and express them in ways that people can understand.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Sophie Spector, BA &#x27;22&lt;/strong&gt; PhD Student, Harvard Medical School&lt;/p&gt;&lt;p&gt;&lt;strong&gt;After Gallatin,&lt;/strong&gt; I have continued my work to address very real, very targeted public health challenges.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/why-gallatin/meaningful-work.html&quot;&gt;Meaningful Work Happens Here&lt;/a&gt;&lt;/p&gt;"></item_2>
        </block>
