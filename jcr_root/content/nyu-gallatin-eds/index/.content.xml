            <col2 jcr:primaryType="nt:unstructured">
              <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="It&#x27;s Your Journey" titleType="h2"/>
              <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;You chase the thrill of discovery that comes from
                    rigorous and intentional exploration. You challenge
                    yourself and work to find your own way. At NYU Gallatin,
                    adventurous thinkers create unique academic journeys that
                    span subjects, ideas, and experiences that could only
                    happen in New York City. Curious?&lt;/p&gt;"/>
              <button sling:resourceType="core/franklin/components/button/v1/button" jcr:primaryType="nt:unstructured" link="/academics.html" linkText="Academics at Gallatin"/>
