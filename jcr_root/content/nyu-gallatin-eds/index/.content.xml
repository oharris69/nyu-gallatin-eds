      <section_1 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,style,sec-full-width]">
        <block sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" model="video" modelFields="[videoUrl]" name="Video" videoUrl="https://cdnapisec.kaltura.com/html5/html5lib/v2.104/mwEmbedFrame.php?wid=_&amp;entry_id=1_28gzt3o8"></block>
        <block_1 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="carousel" model="carousel" modelFields="[autoplay,autoplayInterval,imageZoom]" name="Carousel">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/faculty/09-2025-ben-ratliff-no-background-1200x1200.png" text="&lt;p&gt;&lt;h3&gt;The Cultural Critic&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;“As a faculty adviser, I&#x27;m a co-conspirator in a way. I can&#x27;t assume that I know why my students are here or what they&#x27;re interested in. Over months and years, I learn who my students are, what they&#x27;re interested in, and the directions they want to go. I commonly know something about the fields they&#x27;re interested in — journalism, music, critical writing — so I can help them figure out what courses, what books, what records they should be checking out to make their academic work meaningful and help them best prepare for where they want to go after graduation.”&lt;strong&gt;—Ben Ratliff, Clinical Associate Professor&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/academics/faculty/ben-ratliff.html&quot;&gt;Meet Professor Ratliff&lt;/a&gt;&lt;/p&gt;"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/faculty/10-2025-kwami-coleman-no-background-1200x1200.png" text="&lt;p&gt;&lt;h3&gt;The Musicologist&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;“I like to create a buffer zone for students to explore their interests in ways that may not &lt;em&gt;seem&lt;/em&gt; career oriented, but that gives them the chance to build their thinking and problem solving skills in ways that are useful for any career. They develop a toolbox that they can carry from industry to industry and career prospect to career prospect. They may not graduate from Gallatin with a particular career path printed on their diploma, but they walk away with that toolbox that&#x27;ll be with them regardless of where they go.”&lt;strong&gt;—Kwami Coleman, Associate Professor&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/academics/faculty/kwami-coleman.html&quot;&gt;Meet Professor Coleman&lt;/a&gt;&lt;/p&gt;"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text,style,ctastyle]" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/portraits/faculty/10-2025-julie-malnig-no-background-1200x1200.png" text="&lt;p&gt;&lt;h3&gt;The Dance Historian&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;“Advising at Gallatin is one of the most rewarding aspects of my work. I get to key in on what students&#x27; interests and passions are, and then help them develop those interests into a focused course of study. I love getting to know my students and what excites them and help guide them during their time at Gallatin.”&lt;strong&gt;—Julie Malnig, Professor&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/academics/faculty/julie-malnig.html&quot;&gt;Meet Professor Malnig&lt;/a&gt;&lt;/p&gt;"></item_2>
        </block_1>
