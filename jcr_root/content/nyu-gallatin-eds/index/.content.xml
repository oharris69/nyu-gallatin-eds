            <col1 jcr:primaryType="nt:unstructured">
              <image sling:resourceType="core/franklin/components/image/v1/image" jcr:primaryType="nt:unstructured" image="https://gallatin.nyu.edu/content/dam/nyugallatin/photos/student-life/2025-08-orientation-governors-island-50-50-crop-1800x1800.jpg" imageAlt="A female-presenting student, wearing a light pink tank top and sunglasses on her head. She has long brown hair and is talking with other people. The background shows other students engaged in conversation and a yellow house in the distance."/>
            </col1>
            <col2 jcr:primaryType="nt:unstructured">
              <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Learn Without Walls" titleType="h2"/>
              <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;Research and internships. Creative innovation and
                    community engagement. Study away and student-run
